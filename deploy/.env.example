# Settings for a self-hosted or offline install (deploy/compose.yaml).
# Copy to deploy/.env and fill in. Every setting is an environment variable.

# Required: a long random string. python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Where people open the dashboard
PUBLIC_URL=http://risa.kobo.local
ALLOWED_HOSTS=*

# Needed to create a response. Leave empty to let anyone on the network create one.
CREATE_KEY=
# false: viewing needs the response's edit key too
READ_ONLY_PUBLIC=true

# Kobo servers this instance may connect to. http:// is accepted only when listed exactly.
# Online:  https://kf.kobotoolbox.org,https://eu.kobotoolbox.org
# On a kobo-in-a-box:  http://kf.kobo.local
ALLOWED_SERVERS=https://kf.kobotoolbox.org,https://eu.kobotoolbox.org

# false on an offline box: hides basemaps that need the internet. Load offline basemaps
# (PMTiles) into the media volume under basemaps/.
ONLINE_BASEMAPS=true

# Files: filesystem (default, a docker volume) or s3 (any S3-compatible store)
STORAGE=filesystem
# S3_BUCKET=
# S3_ENDPOINT_URL=https://fra1.digitaloceanspaces.com
# S3_REGION=fra1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# MEDIA_PUBLIC_URL=https://<bucket>.fra1.cdn.digitaloceanspaces.com

POSTGRES_PASSWORD=change-me
